@inherits LayoutComponentBase
@inject DocumentMDConverter.Application.Interfaces.IUserContextService UserContext

<div class="d-flex flex-column min-vh-100">
    <header class="top-nav-bar">
        <div class="app-layout-container d-flex align-items-center justify-content-between py-3">
            <a href="" class="brand-container">
                <div class="brand-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                </div>
                <span class="brand-title">DocumentMDConverter</span>
            </a>

            <!-- Right Controls: Authenticated User & Instant Theme Toggle Button -->
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(currentUserEmail))
                {
                    <div class="user-identity-badge d-flex align-items-center gap-2" title="Authenticated User (Google IAP)">
                        <span class="user-status-dot"></span>
                        <span class="user-email-text">@currentUserEmail</span>
                    </div>
                }

                <button type="button" 
                        class="theme-toggle-btn" 
                        onclick="window.converterUtils && window.converterUtils.toggleTheme()" 
                        title="Toggle Light / Dark mode" 
                        aria-label="Toggle theme">
                    <!-- Sun Icon (visible in dark mode) -->
                    <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                    <!-- Moon Icon (visible in light mode) -->
                    <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow-1">
        <div class="app-layout-container pt-3 pb-4 pb-md-5">
            @Body
        </div>
    </main>

    <footer class="py-4 mt-auto" style="border-top: 1px solid var(--border-subtle);">
        <div class="app-layout-container d-flex flex-wrap justify-content-between align-items-center theme-text-secondary" style="font-size: 0.82rem;">
            <div>
                DocumentMDConverter — Powered by <strong>Firecrawl anydoc (Rust Engine)</strong> & <strong>Google Cloud Vision OCR</strong>
            </div>
            <div class="d-flex gap-3">
                <span>Clean Markdown</span>
                <span>•</span>
                <span>Table Extraction</span>
                <span>•</span>
                <span>Smart OCR</span>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string currentUserEmail = string.Empty;

    protected override void OnInitialized()
    {
        try
        {
            currentUserEmail = UserContext.GetCurrentUserEmail();
        }
        catch
        {
            currentUserEmail = string.Empty;
        }
    }
}