<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    <script>
        (function() {
            var savedTheme = localStorage.getItem('mdai-theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["css/modern-converter.css"]"/>
    <link rel="stylesheet" href="@Assets["DocumentMDConverter.Web.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" type="image/png" sizes="64x64" href="favicon.png?v=2"/>
    <link rel="icon" type="image/svg+xml" href="favicon.svg?v=2"/>
    <link rel="shortcut icon" href="favicon.ico?v=2"/>
    <HeadOutlet/>
</head>

<body>
<Routes @rendermode="InteractiveServer" />
<ReconnectModal/>
<script src="@Assets["js/converter.js"]"></script>
<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>